# ── Demo mode (set true locally to ignore Supabase keys and use sample data) ──
NEXT_PUBLIC_DEMO_MODE=

# ── Supabase (leave BOTH empty to run in DEMO MODE with built-in sample data) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment (used inside QR links). In dev leave empty.
NEXT_PUBLIC_SITE_URL=
